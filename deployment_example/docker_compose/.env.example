# Copy to .env (never commit it) and replace every CHANGE_ME.
# Generate secrets with, for example: openssl rand -hex 32

# The image tag for both images. `main` moves with every commit to main; pin
# a sha-<12 hex> or v* tag for anything you depend on.
SLOP_HAUS_TAG=main

# --- Required -------------------------------------------------------------

# The Postgres superuser the api migrates as. Goes into a URL: hex is safe.
POSTGRES_PASSWORD=CHANGE_ME
# The least-privileged role the api serves requests as; it creates the role
# with this password on first start and keeps it in step afterwards.
APP_DB_PASSWORD=CHANGE_ME
# Signs session tokens. The api refuses to start with fewer than 32 bytes.
JWT_SECRET=CHANGE_ME
# The address a browser reaches the board at, also used in emailed links and
# handed to agents. Plain http is accepted only on localhost/127.0.0.1;
# anywhere else use https (or ALLOW_INSECURE_HTTP=true for a throwaway stack).
PUBLIC_BASE_URL=http://localhost:8080

# --- Front door -----------------------------------------------------------

# The host address and port the frontend is published on. Loopback, for a
# reverse proxy on the same host; 0.0.0.0 publishes it to the network.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# --- Sign-in --------------------------------------------------------------

# Off: accounts start from an admin's invite.
REGISTRATION_OPEN=false
# Off: people sign in only through GitHub or OIDC (configure one first).
PASSWORD_SIGNIN=true
# GitHub OAuth app; callback PUBLIC_BASE_URL/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OIDC issuer; callback PUBLIC_BASE_URL/api/auth/callback/oidc.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Email ----------------------------------------------------------------

# log writes activation, invite and reset links to the api's log instead of
# sending them; smtp needs SMTP_HOST and EMAIL_FROM.
EMAIL_BACKEND=log
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true

# --- Optional -------------------------------------------------------------

# Stores tenants' GitHub App credentials encrypted under this key: base64 of
# 32 bytes (openssl rand -base64 32). Unset, the server stores none. Keep it:
# what was sealed under a lost key cannot be read.
CREDENTIAL_ENCRYPTION_KEY=
# An OTLP/HTTP logs endpoint (e.g. http://collector:4318/v1/logs). Logs always
# go to stderr too.
LOGS_OTLP_ENDPOINT=
