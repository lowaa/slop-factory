    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^4.1.10",
    "oxlint": "^1.91.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.107.1",
