{
  "name": "@slop-factory/storybook-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./default_style_check": "./src/default_style_check.ts",
    "./story_coverage": "./src/story_coverage.ts",
    "./design_tokens": "./src/design_tokens.ts",
    "./preview_tokens": "./.storybook/preview_tokens.scss",
    "./api_guard": "./src/api_guard.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "../../node_modules/typescript-native/bin/tsc --noEmit",
