# The oxlint ratchet: the configs, the baseline and the scripts. The
# type-aware rules read the js-components packages through their tsconfigs.
!.gitignore
!slop-haus/frontend/.gitignore
!slop-haus/frontend/.oxlintrc.json
!slop-haus/frontend/lint_baseline
!slop-haus/frontend/lint_baseline/**
# Linted with the rest; bundle_budget.mjs is allowed above for its own use.
!slop-haus/frontend/tools/import_boundaries.mjs
!js-components/*/tsconfig.json
!dev-tools/lint/oxlint.sh
!dev-tools/lint/ratchet.sh
!dev-tools/lint/findings.mjs
!dev-tools/lint/oxlintrc.base.json

# The user guide the help area bundles.
!slop-haus/docs/guide
!slop-haus/docs/guide/*.md

# Fixtures the server tests share with the frontend tests.
!slop-haus/testdata

# The privacy inventory browser_storage.test.ts checks the adapter's keys against.
!slop-haus/server/privacy/inventory.yaml

# The server's usage allowlist src/usage/allowlist_parity.test.ts checks the catalog against.
!slop-haus/server/internal/usagemetrics/ui_allowlist.json
