{
  "name": "slop-haus-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6011 --no-open",
    "build-storybook": "storybook build",
    "build": "../../node_modules/typescript-native/bin/tsc -b && vite build && vite build --config vite.admin.config.ts",
    "typecheck": "../../node_modules/typescript-native/bin/tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "generate:api": "./generate_api_client.sh",
    "generate:usage_allowlist": "node --experimental-strip-types src/usage/generate_allowlist.ts"
  },
  "dependencies": {
    "@slop-factory/auth": "*",
    "@slop-factory/logging": "*",
    "@slop-factory/privacy": "*",
    "@slop-factory/router": "*",
    "@slop-factory/storage": "*",
    "@slop-factory/ui": "*",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-virtual": "^3.14.26",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@slop-factory/storybook-kit": "*",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.91.0",
    "playwright": "^1.64.1",
    "sass": "^1.107.1",
    "storybook": "^10.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10",
    "yaml": "^2.8.0"
  }
}
