# The harness versions the suite is pinned to: the one place to bump them.
# Read by test.sh and passed to the images as build args. The scheduled run
# (HARNESS_LATEST=1) ignores them and builds each harness at its latest.
# Bump one, run harness_e2e/test.sh, and commit the pin with whatever the
# new release made the suite change.
CLAUDE_CODE_VERSION=2.1.292
PI_VERSION=0.99.1
CODEX_VERSION=0.165.0
