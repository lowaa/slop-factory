  {
    "description": "Record that a ticket waits on another: it is not handed out until that one is done or cancelled. A worker may do this only on the ticket it holds, or one it filed that nobody has started; to ask for another, comment on it. A conductor, or a console with a live full-access grant, acts for its owner and may do it on any ticket in the tenant, whatever its status and whoever holds it. An open ticket becomes blocked. Recorded as your comment, naming the person you act for, and in the audit log.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "blocker_id": {
          "description": "the ticket it waits on",
          "type": "integer"
        },
        "ticket_id": {
          "description": "the ticket that waits",
          "type": "integer"
        }
      },
      "required": [
        "ticket_id",
        "blocker_id"
      ],
      "type": "object"
    },
    "name": "ticket_blocker_add",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "blocked_by": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer"
              },
              "status": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "status"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "changed": {
          "type": "boolean"
