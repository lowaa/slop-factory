  {
    "description": "Add a comment. Material decisions belong here -- the rest of the fleet cannot see your terminal. attempt: only a console or a conductor passes it, to name which of a ticket's attempts it means. With one live attempt it can be left out; with several and none named the call is refused with the list. A worker never passes it -- its lease already names its attempt -- and is refused if it does.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "description": "only a console or conductor: the attempt the comment is addressed to, which then only that attempt's agent is told; left out on a ticket with several live attempts, every one of them is told; a worker never passes it",
          "type": [
            "null",
            "integer"
          ]
        },
        "body": {
          "type": "string"
        },
        "ticket_id": {
          "type": "integer"
        }
      },
      "required": [
        "ticket_id",
        "body"
      ],
      "type": "object"
    },
    "name": "ticket_comment",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "human_message": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  {
    "description": "File a follow-up ticket. Does not claim it. It starts in preparing, where no agent can take it until a human opens it. Pass status open only when you were specifically asked to file it as open.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "base_ref": {
          "description": "a commit hash or a tag the work starts from, not a branch. Leave it out to start from the base branch's tip when the ticket is claimed",
          "type": "string"
        },
        "blocked_on": {
          "description": "ticket numbers the new ticket waits on",
          "items": {
            "type": "integer"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "body": {
          "type": "string"
        },
        "paths": {
          "description": "the narrowest repo-relative paths you expect the work to write, end a directory with /. Prefer leaf directories or files over shared roots: where the tenant locks path scopes, a broad scope stops every overlapping ticket from being claimed while this one is held. Whoever takes the ticket extends it with ticket_scope_extend as it finds it needs more",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "priority": {
          "description": "low, normal, high or urgent",
          "type": "string"
        },
        "role_match": {
          "description": "any (the default): one of the roles is enough; all: every one",
          "type": "string"
        },
        "roles": {
          "description": "role names, exactly as spelled; only an agent with them may claim it",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "status": {
          "description": "preparing (the default) or open. Only open if you were specifically asked to file it as open",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
