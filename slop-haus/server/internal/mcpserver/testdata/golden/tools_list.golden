  },
  {
    "description": "Say the work on your ticket is finished and let the server decide what happens next, Push your branch first. The ticket goes to a human's review (it records the handoff and releases the ticket and the integration lock) when it requires approval and has none yet, when your attempt is not the ticket's promoted one, or when you pass request_review with a reason (rare: a finished change whose code you want a human to read, such as a risky, security-sensitive or migration change; a question about direction is ticket_discuss). Where the tenant lands by the server's merge queue, the ticket otherwise goes into the landing queue and you no longer hold it: slop-haus merges the base branch, waits for CI and merges the change itself, and hands the ticket back with the reason if it cannot. Otherwise you keep the ticket and the reply gives the merge steps, which end at change_merge: that merges the change and closes the ticket. Where the tenant has no change tools, pass pr_url, the change you merged: the ticket is then closed with it. handoff names the branch, the PR and the pushed commit; it is required for a review. pr_url is optional where change_open recorded the change. A ticket that ends with nothing to merge (a split parent whose parts are all done or cancelled, an investigation that concludes there is nothing to change) is closed as done with no_change true and a reason, which becomes the closing comment: slop-haus refuses it while the attempt has a change or commits beyond the ticket's base commit, or while a ticket it waits on is open.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "handoff": {
          "description": "where the work stands -- branch, PR, pushed commit -- for whoever picks the ticket up; required when the ticket goes to review",
          "type": "string"
        },
        "no_change": {
          "description": "close the ticket as done with no change to merge; needs a reason, and slop-haus checks there really is none",
          "type": "boolean"
        },
        "pr_url": {
          "description": "the https URL of the change; needed only where change tools are off, or to hand over a change not opened with change_open",
          "type": "string"
        },
        "reason": {
          "description": "with request_review: why a human should read it (risky, security-sensitive, a migration you are unsure of); with no_change: why there is nothing to merge, recorded as the closing comment",
          "type": "string"
        },
        "red_was_flake": {
          "description": "after the landing queue handed the ticket back with red checks: the id of the open or done 'CI flake:' ticket that covers the failure, which allows one more landing attempt of the same head; without it a head that already went red is refused until you push a new commit",
          "type": "integer"
        },
        "request_review": {
          "description": "ask for a human to read this finished change before it merges; needs a reason",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ticket_finish",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "human_message": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      },
      "required": [
        "next",
        "message"
      ],
      "type": "object"
    }
  },
