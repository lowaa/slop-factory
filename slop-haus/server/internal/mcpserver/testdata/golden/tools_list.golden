            "id": {
              "type": "string"
            },
            "size_bytes": {
              "type": "integer"
            },
            "uploaded_by": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "filename",
            "content_type",
            "size_bytes",
            "uploaded_by",
            "at"
          ],
          "type": "object"
        },
        "human_message": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        }
      },
      "required": [
