  {
    "description": "Find or list tickets: by the words in them (every word must appear somewhere on the ticket), by status (statuses, e.g. [\"preparing\"]; text is then optional), or both -- e.g. to see whether a ticket already exists before filing one, or to review everything in preparing. Listing is not claiming: ticket_next is how work is taken. Searches what the board shows, and parked tickets too (kept, not planned: never work to take); done ones only when asked. Newest first; ticket_get for detail.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "include_done": {
          "description": "also search done tickets; not with statuses",
          "type": "boolean"
        },
        "statuses": {
          "description": "only tickets in exactly these statuses, e.g. [\"preparing\"]; the whole set, so [\"done\"] alone lists done ones. cancelled is refused. Not with include_done",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "text": {
          "description": "words that must each appear, in any case, somewhere in a ticket's title, description, comments or handoff; leave out to list by statuses alone",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ticket_search",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "human_message": {
          "type": "string"
        },
        "more": {
          "type": "boolean"
        },
        "notice": {
          "type": "string"
        },
        "tickets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "integer"
              },
              "priority": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "status",
              "priority"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "tickets"
      ],
      "type": "object"
    }
  },
  {
    "description": "Read your tenant's workspace manifest: each repo's path and remote, its deploy-only rules, and its shared paths with how a conflict in each is resolved. Use it to check how a path is treated before claiming or extending scope, or, in a console, to review the settings with your person. Read-only: an owner changes the manifest on the board. A tenant that has declared none gets an empty list: nothing is then enforced.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "workspace_get",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "declared": {
          "description": "false while the tenant has declared no manifest",
          "type": "boolean"
        },
        "human_message": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "repos": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "base_branch": {
                "description": "the branch this tenant's changes to the repo merge into; absent means the repo's default branch. Nothing reads it yet",
                "type": "string"
              },
              "batch_within_apps": {
                "description": "whether the landing queue may batch changes that each touch one of the independent_apps (also needs merge_queue_batch_size above 1); off by default",
                "type": "boolean"
              },
              "deploy_only": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "lines": {
                      "description": "regular expression every changed line must match for a commit to count as a deploy; empty for any line",
                      "type": "string"
                    },
                    "path": {
                      "description": "file pattern relative to the repo's root",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "independent_apps": {
                "description": "directory prefixes (ending in /) of apps that build and deploy independently; empty when none is declared",
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "path": {
                "description": "where the repo is checked out under the workspace root: one directory name",
                "type": "string"
              },
              "protected_paths": {
                "description": "paths that are always the owner's decision for the steward's judgment categories; owner-set. Keep them when you propose a manifest edit",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "description": "directory prefix when it ends in /, otherwise a file pattern, relative to the repo's root",
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "remote": {
                "type": "string"
              },
              "shared_paths": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "on_clash": {
                      "description": "what to do when merging the base branch conflicts there",
                      "type": "string"
                    },
                    "path": {
                      "description": "directory prefix when it ends in /, otherwise a file pattern, relative to the repo's root",
                      "type": "string"
                    },
                    "resolve": {
                      "description": "migration or regenerate",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "resolve",
                    "on_clash"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "skip_retest_across_apps": {
                "description": "whether a change behind main may merge on its existing CI when main moved only in other independent_apps; off by default",
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "remote",
              "deploy_only",
              "shared_paths",
              "protected_paths",
              "independent_apps",
              "batch_within_apps",
              "skip_retest_across_apps"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "revision": {
          "description": "the manifest's revision: pass it as base_revision to propose_manifest_edit; it is kept when the manifest is cleared",
          "type": "integer"
        },
        "updated_at": {
          "type": [
            "null",
            "string"
          ]
        },
        "updated_by": {
          "description": "the user who last saved it; absent if they have since been deleted",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "revision",
        "declared",
        "repos"
      ],
      "type": "object"
    }
  }
]
