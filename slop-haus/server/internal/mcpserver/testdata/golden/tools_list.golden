          ]
        }
      },
      "required": [
        "agent"
      ],
      "type": "object"
    }
  },
  {
    "description": "Take the merge lock for the final re-check and merge. Merge the ticket's base branch into your branch, resolve conflicts, test and wait for green checks BEFORE taking it; under it only fetch, confirm the base branch has not moved (or that merging it is clean and touches none of your paths), and change_merge. Pins your lease until released, so release it before investigating a failed check. If it is held, or reserved for an agent ahead of you, you join the queue (once) and the refusal says your position, who is ahead and since when, and who holds it: end your turn at that wait point rather than retrying; you are resumed when the lock is yours. Refused on an attempt that is not the ticket's promoted one, which cannot merge: finish with ticket_finish.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "integration_lock",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "human_message": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  {
    "description": "Release the merge lock.",
    "inputSchema": {
      "additionalProperties": false,
      "type": "object"
    },
    "name": "integration_unlock",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "human_message": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  {
    "description": "Attach a small image to a ticket (base64, up to 512 KB). For anything larger, or a video, upload from your working copy: curl -sS -H \"Authorization: Bearer $(.slop-haus/token.sh)\" -F file=@PATH $SERVER/api/agent/tickets/ID/attachments (images up to 10 MB, MP4/WebM/MOV up to 100 MB). A worker may attach only to the ticket it holds; a console or conductor to any.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "content_base64": {
          "description": "the image, base64-encoded; PNG, JPEG, WebP or GIF, up to 512 KB",
          "type": "string"
        },
        "filename": {
          "description": "a name for display, e.g. login-error.png; never used as a path",
          "type": "string"
        },
        "ticket_id": {
          "type": "integer"
        }
      },
      "required": [
        "ticket_id",
        "filename",
        "content_base64"
      ],
      "type": "object"
