        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  {
    "description": "Change the title and/or description of the ticket you hold, when what it says no longer matches the work. Pass the revision ticket_get showed; a body replaces the whole description. The old text is kept in the ticket's history. Only your own held ticket; to flag a problem with another, comment on it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "the new description, in full: it replaces the old one",
          "type": [
            "null",
            "string"
          ]
        },
        "revision": {
          "description": "the ticket's revision as ticket_get last showed it; refused if the ticket has been edited since",
          "type": "integer"
        },
        "title": {
          "description": "the new title",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "revision"
      ],
      "type": "object"
    },
    "name": "ticket_edit",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "human_message": {
          "type": "string"
        },
        "notice": {
          "type": "string"
