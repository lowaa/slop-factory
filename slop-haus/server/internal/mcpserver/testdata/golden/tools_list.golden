          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "changed",
        "status",
        "blocked_by"
      ],
      "type": "object"
    }
  },
  {
    "description": "A worker may remove only a blocker it added itself, on the ticket it holds or one it filed that nobody has started; a blocker a human added is theirs to lift, so comment instead. A conductor, or a console with a live full-access grant, acts for its owner and may remove any blocker on any ticket in the tenant; removing the last one unblocks the ticket. Recorded as your comment, naming the person you act for, and in the audit log.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "blocker_id": {
          "description": "the ticket it waits on",
