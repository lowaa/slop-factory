  {
    "description": "Stop work on your ticket until the human answers a question. Posts the question as your comment, records a handoff for whoever continues it, and releases the ticket. Their reply puts it back in the queue, with you first in line. Commit and push your work to the ticket's branch first, and name the branch and pushed commit in the handoff: whoever continues may be on another checkout.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "handoff": {
          "description": "where the work stands, what was decided, what you would do next -- for whoever picks the ticket up",
          "type": "string"
        },
        "question": {
          "description": "what you need the human to answer; posted as your comment",
          "type": "string"
        }
      },
      "required": [
        "question",
        "handoff"
      ],
      "type": "object"
    },
