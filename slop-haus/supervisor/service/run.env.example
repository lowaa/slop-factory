# <root>/run.env: what the supervisor's environment needs that a launcher does not give it.
# Parsed, never sourced: no $VAR, ~ or $(...) expansion, so write absolute paths. Not for secrets
# (those go in secrets.env). PATH here is added in front of the launcher's PATH.
PATH=/home/you/.local/bin:/home/you/go/bin:/home/you/.nvm/versions/node/v22/bin:/usr/local/bin
# What Docker needs when it is not at the default socket:
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# Where git finds an ssh-agent, if the launcher does not provide one:
# SSH_AUTH_SOCK=/run/user/1000/ssh-agent.socket
