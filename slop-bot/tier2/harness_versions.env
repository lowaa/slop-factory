# The harness versions tier 2 is pinned to: the one place to bump them.
# Read by ../tier2.sh and passed to the image as build args, and checked
# against each CLI's --version in the run (TestContainerHarnessVersions).
# HARNESS_LATEST=1 ignores them and builds each harness at its latest.
# Bump one, run ../tier2.sh, and commit the pin with whatever the new release
# made tier 2 change.
CLAUDE_CODE_VERSION=2.1.332
CODEX_VERSION=0.172.0
PI_VERSION=1.4.0
