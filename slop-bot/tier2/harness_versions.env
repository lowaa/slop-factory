# The harness versions tier 2 is pinned to: the one place to bump them.
# Read by ../tier2.sh and passed to the image as build args, and checked
# against each CLI's --version in the run (TestContainerHarnessVersions).
# HARNESS_LATEST=1 ignores them and builds each harness at its latest.
# Bump one, run ../tier2.sh, and commit the pin with whatever the new release
# made tier 2 change.
CLAUDE_CODE_VERSION=2.1.332
CODEX_VERSION=0.172.0
PI_VERSION=1.4.0
# agy is a tarball from Google's bucket, not an npm package (install_agy.sh):
# its release names the build in the URL, and the checksums are the ones its
# release manifest gave (.../manifests/linux_amd64.json, linux_arm64.json).
# Bump all four together.
AGY_VERSION=1.5.19
AGY_RELEASE=1.5.19-4821414830800896
AGY_SHA512_AMD64=8160da6ceef2b7b62bb4a630b54b3fb4ee5283377509230736880c4ba4815e848a25cf346954a98134b647eb2f5d34e0364e77fbf74367ffd7dc29c525ddd82d
AGY_SHA512_ARM64=eeecedfc2a63af281e245d73bb69f949a17c6d3ebcd3d023220056ddcc05e204a00d1d0ea77f68741b2fc15a1f66f740bc0e3bf800d734721c60938e61653010
