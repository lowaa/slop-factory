# Written by `slop-bot service install`. Re-run it rather than editing this
# file: it resolves the paths and PATH below from your shell, so the daemon
# agrees with the CLI.
[Unit]
Description=slop-bot: coding agents on tickets

[Service]
Type=exec
ExecStart="/home/ada/go/bin/slop-bot" daemon
WorkingDirectory=/home/ada
Environment="XDG_CONFIG_HOME=/home/ada/.config"
Environment="XDG_DATA_HOME=/home/ada/.local/share"
Environment="XDG_STATE_HOME=/home/ada/.local/state"
Environment="XDG_CACHE_HOME=/home/ada/.cache"
Environment="PATH=/home/ada/.local/bin:/home/ada/go/bin:/usr/local/bin:/usr/bin:/bin"
# systemd sets XDG_RUNTIME_DIR, and creates and removes the socket directory.
RuntimeDirectory=slop-bot
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5s
# SIGTERM goes to the daemon alone, so it can stop its agents in order; only
# what is still running after the timeout is SIGKILLed.
KillMode=mixed
TimeoutStopSec=45s

[Install]
WantedBy=default.target
