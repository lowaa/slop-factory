{
  "format": ["go", "typescript", "tsx", "javascript"],
  "minTokens": 70,
  "minLines": 6,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/package-lock.json",
    "**/go.sum",
    "**/uv.lock",
    "**/api_generated/**",
    "**/testdata/**",
    "go-llm-usage/pricing/prices_gen.go",
    "slop-haus/e2e_playwright_ts/e2e_support/**",
    "**/dist/**",
    "**/*_test.go",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.stories.tsx"
  ],
  "reporters": ["json"],
  "silent": true
}
